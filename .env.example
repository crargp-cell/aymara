# Plantilla de variables de entorno. Copiar a `.env` y rellenar.
#
#   cp .env.example .env
#
# El `.env` real no se versiona (está en .gitignore), así que al clonar en una
# máquina nueva este archivo es el único punto de partida.

# ---------------------------------------------------------------------------
# Base de datos — OBLIGATORIA
# ---------------------------------------------------------------------------
# PostgreSQL 16. El esquema se aplica con `npx prisma db push` (el proyecto no
# usa carpeta de migraciones).
DATABASE_URL="postgresql://postgres:TU_CLAVE@localhost:5432/aymara"

# ---------------------------------------------------------------------------
# Sesiones — OBLIGATORIA
# ---------------------------------------------------------------------------
# Firma los JWT de NextAuth. Generar una nueva por instalación:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Si cambia, todas las sesiones abiertas se invalidan (nadie pierde datos, sólo
# hay que volver a entrar).
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# NEXTAUTH_URL — dejar SIN definir a propósito
# ---------------------------------------------------------------------------
# Con `trustHost: true` (src/lib/auth.config.ts) el host se deduce de la
# petición. Fijarlo a localhost rompe el login detrás de un túnel: tras
# autenticarse, el redirect mandaría al visitante a SU propia máquina.
# NEXTAUTH_URL=

# ---------------------------------------------------------------------------
# Chat del cóndor — OPCIONAL
# ---------------------------------------------------------------------------
# Sin ella el chat sigue funcionando: responde consultando el diccionario y las
# lecciones en vez de usar el modelo (src/app/api/chat/route.ts).
XAI_API_KEY=""
