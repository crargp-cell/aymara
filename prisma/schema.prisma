// Plataforma educativa de Aymara — colegio ÚNICO, materia ÚNICA (Aymara).
// Estructura de negocio: Colegio → Gestión → Grado → Paralelo → Profesor → Alumnos → Contenido.
// Reglas invariantes (Negocio.md §36): el contenido pertenece al PARALELO, no al profesor;
// nada académico se borra físicamente (se usan estados); el historial del alumno sobrevive a
// cualquier cambio de profesor / paralelo / gestión.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UsuariosRoleEnum {
  maestro
  estudiante
  admin

  @@map("usuarios_role_enum")
}

/// Ciclo de vida de contenido / entidades académicas (Negocio.md §3, §33).
enum EstadoContenido {
  activo
  inactivo
  retirado
  archivado
  deshabilitado

  @@map("estado_contenido_enum")
}

/// Ciclo de vida del alumno dentro de un paralelo (Negocio.md §2, §25).
enum EstadoAlumno {
  activo
  inactivo
  retirado
  reincorporado
  egresado
  promovido
  trasladado
  repitente

  @@map("estado_alumno_enum")
}

enum EstadoGestion {
  planificada
  activa
  cerrada
  archivada

  @@map("estado_gestion_enum")
}

enum Dificultad {
  facil
  medio
  dificil

  @@map("dificultad_enum")
}

enum ExercisesTypeEnum {
  text
  multiple_choice
  matching
  fill_in_the_blank
  /// Imagen borrosa que se aclara con cada fallo; el alumno escribe la palabra.
  image_guess
  /// Se arrastra a la palabra la tarjeta cuya imagen le corresponde.
  drag_card

  @@map("exercises_type_enum")
}

enum ExamsTypeEnum {
  conectar_palabras
  ar_exam

  @@map("exams_type_enum")
}

enum ExamAttemptPolicy {
  best
  last
  first
  average

  @@map("exam_attempt_policy_enum")
}

enum PassPolicy {
  por_minimo
  todos

  @@map("pass_policy_enum")
}

enum TipoCambio {
  menor
  mayor

  @@map("tipo_cambio_enum")
}

enum MovimientoTipo {
  alta
  promocion
  cambio_paralelo
  retiro
  reincorporacion
  repitencia

  @@map("movimiento_tipo_enum")
}

enum ArCardUnlockType {
  lesson
  exam

  @@map("ar_card_unlock_type_enum")
}

enum LogroCategoria {
  lecciones
  racha
  rendimiento
  examenes
  tarjetas

  @@map("logro_categoria_enum")
}

enum ContentOrderContentTypeEnum {
  lesson
  exam

  @@map("content_order_content_type_enum")
}

enum ExamDetailsConfigTypeEnum {
  categories
  ar_markers
  ar_cards

  @@map("exam_details_config_type_enum")
}

enum StatType {
  exercise
  lesson
  paralelo
  student
  gestion

  @@map("statistics_stat_type_enum")
}

enum PrediccionTipo {
  riesgo_bajo_rendimiento
  tendencia
  refuerzo_sugerido
  score_predicho

  @@map("prediccion_tipo_enum")
}

enum AccessLogsActionEnum {
  login_success
  login_failed
  logout
  view
  create
  update
  delete

  @@map("access_logs_action_enum")
}

// ---------------------------------------------------------------------------
// Estructura académica
// ---------------------------------------------------------------------------

model Usuario {
  id                Int              @id @default(autoincrement())
  username          String           @unique @db.VarChar(50)
  password          String           @db.VarChar(255)
  role              UsuariosRoleEnum
  activo            Boolean          @default(true)
  email             String?          @unique @db.VarChar(120)
  nombre            String?          @db.VarChar(120)
  apellido          String?          @db.VarChar(120)
  codigo_estudiante String?          @unique @db.VarChar(40)
  fecha_nacimiento  DateTime?        @db.Date
  created_at        DateTime         @default(now()) @db.Timestamp(6)

  paralelos_dirige  Paralelo[]           @relation("ParaleloProfesor")
  asignaciones      AsignacionProfesor[]
  inscripciones     Inscripcion[]
  lesson_attempts   LessonAttempt[]
  exercise_attempts ExerciseAttempt[]
  exercise_plays    ExercisePlay[]
  exam_attempts     ExamAttempt[]
  ar_cards          UserArCard[]
  logros            LogroAlumno[]
  progreso          UserProgress[]
  topic_readings    TopicReading[]
  predicciones      PrediccionAlumno[]

  @@index([role])
  @@map("usuarios")
}

model Gestion {
  id           Int           @id @default(autoincrement())
  nombre       String        @unique @db.VarChar(60)
  anio         Int
  fecha_inicio DateTime      @db.Date
  fecha_fin    DateTime      @db.Date
  estado       EstadoGestion @default(planificada)
  es_actual    Boolean       @default(false)
  created_at   DateTime      @default(now()) @db.Timestamp(6)

  paralelos Paralelo[]

  @@index([es_actual])
  @@map("gestiones")
}

model Grado {
  id         Int             @id @default(autoincrement())
  nombre     String          @db.VarChar(60)
  nivel      Int
  estado     EstadoContenido @default(activo)
  created_at DateTime        @default(now()) @db.Timestamp(6)

  paralelos Paralelo[]

  @@unique([nivel])
  @@map("grados")
}

model Paralelo {
  id          Int             @id @default(autoincrement())
  gestion_id  Int
  grado_id    Int
  nombre      String          @db.VarChar(10)
  profesor_id Int?
  estado      EstadoContenido @default(activo)
  created_at  DateTime        @default(now()) @db.Timestamp(6)

  gestion        Gestion              @relation(fields: [gestion_id], references: [id])
  grado          Grado                @relation(fields: [grado_id], references: [id])
  profesor       Usuario?             @relation("ParaleloProfesor", fields: [profesor_id], references: [id])
  asignaciones   AsignacionProfesor[]
  inscripciones  Inscripcion[]
  lessons        Lesson[]
  exercises      Exercise[]
  exams          Exam[]
  ar_cards       ArCard[]
  archivos       Archivo[]
  exercise_media ExerciseMedia[]
  content_order  ContentOrder[]
  comentarios    ComentarioRevision[]

  @@unique([gestion_id, grado_id, nombre])
  @@index([profesor_id])
  @@index([gestion_id])
  @@map("paralelos")
}

/// Historial de "quién enseñó qué paralelo y cuándo" (Negocio.md §4, §35).
model AsignacionProfesor {
  id          Int       @id @default(autoincrement())
  paralelo_id Int
  profesor_id Int
  fecha_desde DateTime  @default(now()) @db.Timestamp(6)
  fecha_hasta DateTime? @db.Timestamp(6)
  activo      Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamp(6)

  paralelo Paralelo @relation(fields: [paralelo_id], references: [id])
  profesor Usuario  @relation(fields: [profesor_id], references: [id])

  @@index([paralelo_id])
  @@index([profesor_id])
  @@map("asignaciones_profesor")
}

/// Una fila por (alumno, paralelo). El alumno acumula varias a lo largo de las
/// gestiones y de los cambios de paralelo — el historial NO se destruye (Negocio.md §2, §25, §32).
model Inscripcion {
  id                Int          @id @default(autoincrement())
  alumno_id         Int
  paralelo_id       Int
  estado            EstadoAlumno @default(activo)
  fecha_inscripcion DateTime     @default(now()) @db.Timestamp(6)
  fecha_baja        DateTime?    @db.Timestamp(6)
  motivo            String?      @db.VarChar(255)
  created_at        DateTime     @default(now()) @db.Timestamp(6)
  updated_at        DateTime     @updatedAt @db.Timestamp(6)

  alumno      Usuario               @relation(fields: [alumno_id], references: [id])
  paralelo    Paralelo              @relation(fields: [paralelo_id], references: [id])
  movimientos MovimientoAcademico[]

  @@unique([alumno_id, paralelo_id])
  @@index([alumno_id])
  @@index([paralelo_id])
  @@index([estado])
  @@map("inscripciones")
}

/// Auditoría de los procesos de gestión académica (alta, promoción, retiro, ...).
model MovimientoAcademico {
  id             Int            @id @default(autoincrement())
  inscripcion_id Int
  tipo           MovimientoTipo
  fecha          DateTime       @default(now()) @db.Timestamp(6)
  realizado_por  Int
  datos_previos  Json?
  datos_nuevos   Json?

  inscripcion Inscripcion @relation(fields: [inscripcion_id], references: [id])

  @@index([inscripcion_id])
  @@map("movimientos_academicos")
}

// ---------------------------------------------------------------------------
// Contenido — SIEMPRE pertenece a un paralelo (Negocio.md §5, §31)
// ---------------------------------------------------------------------------

model Lesson {
  id          Int             @id @default(autoincrement())
  paralelo_id Int
  title       String          @db.VarChar(255)
  description String?         @db.Text
  orden       Int             @default(1)
  estado      EstadoContenido @default(activo)

  // Criterio de completado (Negocio.md §9, §17, §35)
  min_correct      Int        @default(1)
  present_count    Int?
  random_selection Boolean    @default(false)
  pass_policy      PassPolicy @default(por_minimo)

  // Versionado de contenido (Negocio.md §15, §24-25)
  content_epoch     Int @default(1)
  min_valid_version Int @default(1)

  // Recompensa
  grants_ar  Boolean @default(false)
  ar_card_id Int?

  default_topic_id Int?
  copiado_de       Int?
  created_by       Int?
  updated_by       Int?
  created_at       DateTime @default(now()) @db.Timestamp(6)
  updated_at       DateTime @updatedAt @db.Timestamp(6)

  paralelo         Paralelo           @relation(fields: [paralelo_id], references: [id])
  reward_card      ArCard?            @relation("LessonRewardCard", fields: [ar_card_id], references: [id])
  topics           LessonTopic[]
  lesson_exercises LessonExercise[]
  versions         LessonVersion[]
  attempts         LessonAttempt[]
  prereq_de        ExamPrerequisito[]

  @@index([paralelo_id, orden])
  @@index([ar_card_id])
  @@map("lessons")
}

model LessonVersion {
  id          Int        @id @default(autoincrement())
  lesson_id   Int
  version     Int
  tipo_cambio TipoCambio
  resumen     String     @db.VarChar(500)
  created_by  Int?
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  vigente     Boolean    @default(true)

  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([lesson_id, version])
  @@map("lesson_versions")
}

model LessonTopic {
  id         Int             @id @default(autoincrement())
  lesson_id  Int
  title      String          @db.VarChar(255)
  content    String?         @db.Text
  archivo_id Int?
  order      Int             @default(0)
  estado     EstadoContenido @default(activo)
  created_at DateTime        @default(now()) @db.Timestamp(6)
  updated_at DateTime        @updatedAt @db.Timestamp(6)

  lesson   Lesson         @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  archivo  Archivo?       @relation(fields: [archivo_id], references: [id])
  readings TopicReading[]
  slides   TopicSlide[]
  media    TopicMedia[]

  @@index([lesson_id])
  @@map("lesson_topics")
}

/// Diapositiva de un tema didáctico, dibujada en el editor de lienzo (columna `canvas`).
/// El alumno las recorre una a una; `audio_id` es el audio de toda la diapositiva.
model TopicSlide {
  id         Int      @id @default(autoincrement())
  topic_id   Int
  order      Int      @default(0)
  /// Resumen de texto para listas (sale del texto más grande del lienzo).
  title      String   @default("") @db.VarChar(255)
  audio_id   Int?
  /// Lienzo libre: { background, ..., elements[] }. Ver src/lib/slide-canvas.ts.
  canvas     Json?
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)

  topic LessonTopic @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  audio TopicMedia? @relation("SlideAudio", fields: [audio_id], references: [id], onDelete: SetNull)

  @@index([topic_id, order])
  @@map("topic_slides")
}

/// Imagen o audio de una diapositiva. Vive en la base (no en disco) porque en
/// Railway el sistema de archivos del contenedor se rehace en cada despliegue.
/// `data` está excluido por defecto en src/lib/prisma.ts.
model TopicMedia {
  id         Int      @id @default(autoincrement())
  topic_id   Int
  /// image | audio
  kind       String   @db.VarChar(10)
  nombre     String   @db.VarChar(255)
  mime       String   @db.VarChar(120)
  size_bytes Int
  data       Bytes
  created_at DateTime @default(now()) @db.Timestamp(6)

  topic       LessonTopic  @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  audioSlides TopicSlide[] @relation("SlideAudio")

  @@index([topic_id])
  @@map("topic_media")
}

model Archivo {
  id           Int             @id @default(autoincrement())
  nombre       String          @db.VarChar(255)
  ruta         String          @db.VarChar(500)
  mime         String?         @db.VarChar(120)
  size_bytes   Int?
  uploaded_by  Int?
  paralelo_id  Int?
  estado       EstadoContenido @default(activo)
  fecha_subida DateTime        @default(now()) @db.Timestamp(6)

  paralelo Paralelo?     @relation(fields: [paralelo_id], references: [id])
  topics   LessonTopic[]

  @@index([paralelo_id])
  @@map("archivos")
}

/// Ejercicios reutilizables: viven en el pool del paralelo y se enlazan a N
/// lecciones mediante LessonExercise (Negocio.md §10, §18).
model Exercise {
  id               Int               @id @default(autoincrement())
  paralelo_id      Int
  lesson_id_origen Int?
  type             ExercisesTypeEnum
  question         String            @db.Text
  answer           String?           @db.Text
  dificultad       Dificultad        @default(medio)
  estado           EstadoContenido   @default(activo)
  copiado_de       Int?
  /// Imagen principal (image_guess). Vive en ExerciseMedia, por paralelo.
  image_id         Int?
  /// Ajustes por tipo, p. ej. { "maxIntentos": 5 } en image_guess.
  config           Json?
  created_by       Int?
  updated_by       Int?
  created_at       DateTime          @default(now()) @db.Timestamp(6)
  updated_at       DateTime          @updatedAt @db.Timestamp(6)

  paralelo     Paralelo               @relation(fields: [paralelo_id], references: [id])
  image        ExerciseMedia?         @relation("ExerciseImage", fields: [image_id], references: [id], onDelete: SetNull)
  plays        ExercisePlay[]
  options      MultipleChoiceOption[]
  pairs        MatchingPair[]
  blanks       FillInTheBlankAnswer[]
  lesson_links LessonExercise[]
  attempts     ExerciseAttempt[]

  @@index([paralelo_id])
  @@map("exercises")
}

model LessonExercise {
  id          Int             @id @default(autoincrement())
  lesson_id   Int
  exercise_id Int
  orden       Int             @default(0)
  estado      EstadoContenido @default(activo)
  added_at    DateTime        @default(now()) @db.Timestamp(6)

  lesson   Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exercise_id], references: [id])

  @@unique([lesson_id, exercise_id])
  @@index([lesson_id, orden])
  @@index([exercise_id])
  @@map("lesson_exercises")
}

model MultipleChoiceOption {
  id           Int     @id @default(autoincrement())
  exercise_id  Int
  option_text  String? @db.VarChar(255)
  option_image String? @db.VarChar(255)
  /// Imagen de la opción (tarjetas de drag_card y opciones con imagen).
  image_id     Int?
  is_correct   Boolean @default(false)

  exercise Exercise       @relation(fields: [exercise_id], references: [id], onDelete: Cascade)
  image    ExerciseMedia? @relation("OptionImage", fields: [image_id], references: [id], onDelete: SetNull)

  @@index([exercise_id])
  @@map("multiple_choice_options")
}

/// Imagen de un ejercicio. Vive en la base (no en disco) y pertenece al paralelo,
/// no a un tema: los ejercicios se reutilizan entre lecciones.
/// `data` queda fuera por defecto (src/lib/prisma.ts).
model ExerciseMedia {
  id          Int      @id @default(autoincrement())
  paralelo_id Int
  nombre      String   @db.VarChar(255)
  mime        String   @db.VarChar(120)
  size_bytes  Int
  data        Bytes
  created_at  DateTime @default(now()) @db.Timestamp(6)

  paralelo  Paralelo               @relation(fields: [paralelo_id], references: [id], onDelete: Cascade)
  exercises Exercise[]             @relation("ExerciseImage")
  options   MultipleChoiceOption[] @relation("OptionImage")

  @@index([paralelo_id])
  @@map("exercise_media")
}

/// Partida de un ejercicio image_guess: el servidor lleva la cuenta de los fallos
/// (y de ahí cuánto se aclara la imagen), nunca el navegador.
model ExercisePlay {
  id          Int      @id @default(autoincrement())
  user_id     Int
  exercise_id Int
  fallos      Int      @default(0)
  resuelto    Boolean  @default(false)
  terminado   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  user     Usuario  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exercise_id], references: [id], onDelete: Cascade)

  @@index([user_id, exercise_id])
  @@map("exercise_plays")
}

model MatchingPair {
  id           Int    @id @default(autoincrement())
  exercise_id  Int
  aymara_word  String @db.VarChar(255)
  spanish_word String @db.VarChar(255)
  orden        Int    @default(0)

  exercise Exercise @relation(fields: [exercise_id], references: [id], onDelete: Cascade)

  @@index([exercise_id])
  @@map("matching_pairs")
}

model FillInTheBlankAnswer {
  id          Int    @id @default(autoincrement())
  exercise_id Int
  answer_text String @db.VarChar(255)

  exercise Exercise @relation(fields: [exercise_id], references: [id], onDelete: Cascade)

  @@index([exercise_id])
  @@map("fill_in_the_blank_answers")
}

// ---------------------------------------------------------------------------
// Historial de aprendizaje del alumno — se conserva SIEMPRE (Negocio.md §12-14)
// ---------------------------------------------------------------------------

/// Cabecera de un intento de lección. Guarda el subconjunto de ejercicios
/// presentado (para que un sorteo aleatorio sea estable dentro del intento).
model LessonAttempt {
  id                     Int             @id @default(autoincrement())
  alumno_id              Int
  lesson_id              Int
  paralelo_id            Int
  attempt_no             Int             @default(1)
  started_at             DateTime        @default(now()) @db.Timestamp(6)
  finished_at            DateTime?       @db.Timestamp(6)
  presented_exercise_ids Int[]
  presented_count        Int             @default(0)
  correct_count          Int             @default(0)
  min_required           Int             @default(0)
  score                  Int             @default(0)
  passed                 Boolean         @default(false)
  best_flag              Boolean         @default(false)
  lesson_version         Int             @default(1)
  estado                 EstadoContenido @default(activo)

  alumno  Usuario           @relation(fields: [alumno_id], references: [id])
  lesson  Lesson            @relation(fields: [lesson_id], references: [id])
  details ExerciseAttempt[]

  @@index([alumno_id, lesson_id])
  @@index([lesson_id])
  @@map("lesson_attempts")
}

/// Detalle: una fila por envío de ejercicio. NO guarda la respuesta correcta
/// (Negocio.md §13, §22 — el fallo no revela la solución).
model ExerciseAttempt {
  id                Int                @id @default(autoincrement())
  lesson_attempt_id Int?
  alumno_id         Int
  exercise_id       Int
  lesson_id         Int
  paralelo_id       Int?
  exercise_type     ExercisesTypeEnum?
  dificultad        Dificultad         @default(medio)
  attempt_number    Int                @default(1)
  user_answer       String?            @db.Text
  is_correct        Boolean            @default(false)
  score             Int                @default(0)
  time_spent_ms     Int                @default(0)
  error_type        String?            @db.VarChar(100)
  error_details     String?            @db.Text
  created_at        DateTime           @default(now()) @db.Timestamp(6)

  lesson_attempt LessonAttempt? @relation(fields: [lesson_attempt_id], references: [id])
  exercise       Exercise       @relation(fields: [exercise_id], references: [id])
  alumno         Usuario        @relation(fields: [alumno_id], references: [id])

  @@index([alumno_id, exercise_id])
  @@index([alumno_id, lesson_id])
  @@index([lesson_id])
  @@index([exercise_id])
  @@index([is_correct])
  @@index([created_at])
  @@map("exercise_attempts")
}

/// Caché de "posición actual / reanudar" de una lección. NO es historial.
model UserProgress {
  id              Int      @id @default(autoincrement())
  alumno_id       Int
  lesson_id       Int
  lesson_version  Int      @default(1)
  current_index   Int      @default(0)
  total_exercises Int      @default(0)
  best_score      Int      @default(0)
  attempts        Int      @default(0)
  completed       Boolean  @default(false)
  in_progress     Boolean  @default(false)
  last_seen_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @updatedAt @db.Timestamp(6)

  alumno Usuario @relation(fields: [alumno_id], references: [id])

  @@unique([alumno_id, lesson_id])
  @@index([alumno_id])
  @@map("user_progress")
}

model TopicReading {
  id                   Int       @id @default(autoincrement())
  alumno_id            Int
  topic_id             Int
  lesson_id            Int
  reading_completed    Boolean   @default(false)
  reading_started_at   DateTime? @db.Timestamp(6)
  reading_completed_at DateTime? @db.Timestamp(6)
  time_spent_ms        Int       @default(0)
  forced_by_failures   Boolean   @default(false)
  failure_count        Int       @default(0)
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  updated_at           DateTime  @updatedAt @db.Timestamp(6)

  alumno Usuario     @relation(fields: [alumno_id], references: [id])
  topic  LessonTopic @relation(fields: [topic_id], references: [id])

  @@unique([alumno_id, topic_id, forced_by_failures])
  @@index([alumno_id, lesson_id])
  @@index([topic_id])
  @@map("topic_readings")
}

// ---------------------------------------------------------------------------
// Exámenes (Negocio.md §16-23)
// ---------------------------------------------------------------------------

model Exam {
  id             Int               @id @default(autoincrement())
  paralelo_id    Int
  type           ExamsTypeEnum     @default(conectar_palabras)
  title          String            @db.VarChar(255)
  description    String?           @db.Text
  time_limit     Int?
  start_date     DateTime?         @db.Timestamp(6)
  end_date       DateTime?         @db.Timestamp(6)
  min_score      Int               @default(70)
  max_attempts   Int?
  attempt_policy ExamAttemptPolicy @default(best)
  ar_card_id     Int?
  position_order Int?
  estado         EstadoContenido   @default(activo)
  copiado_de     Int?
  created_by     Int?
  updated_by     Int?
  created_at     DateTime          @default(now()) @db.Timestamp(6)
  updated_at     DateTime          @updatedAt @db.Timestamp(6)

  paralelo      Paralelo           @relation(fields: [paralelo_id], references: [id])
  reward_card   ArCard?            @relation("ExamRewardCard", fields: [ar_card_id], references: [id])
  prerequisitos ExamPrerequisito[]
  ar_cards      ExamArCard[]
  details       ExamDetail[]
  attempts      ExamAttempt[]

  @@index([paralelo_id])
  @@index([ar_card_id])
  @@map("exams")
}

model ExamPrerequisito {
  id        Int @id @default(autoincrement())
  exam_id   Int
  lesson_id Int

  exam   Exam   @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lesson_id], references: [id])

  @@unique([exam_id, lesson_id])
  @@map("exam_prerequisitos")
}

model ExamArCard {
  id         Int @id @default(autoincrement())
  exam_id    Int
  ar_card_id Int

  exam    Exam   @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  ar_card ArCard @relation(fields: [ar_card_id], references: [id])

  @@unique([exam_id, ar_card_id])
  @@map("exam_ar_cards")
}

model ExamDetail {
  id           Int                       @id @default(autoincrement())
  exam_id      Int
  config_type  ExamDetailsConfigTypeEnum
  config_value String                    @db.Text
  created_at   DateTime                  @default(now()) @db.Timestamp(6)
  updated_at   DateTime                  @updatedAt @db.Timestamp(6)

  exam Exam @relation(fields: [exam_id], references: [id], onDelete: Cascade)

  @@unique([exam_id, config_type])
  @@map("exam_details")
}

model ExamAttempt {
  id                 Int             @id @default(autoincrement())
  exam_id            Int
  alumno_id          Int
  attempt_no         Int             @default(1)
  started_at         DateTime        @default(now()) @db.Timestamp(6)
  completed_at       DateTime?       @db.Timestamp(6)
  time_spent_ms      Int             @default(0)
  score              Decimal         @default(0) @db.Decimal(5, 2)
  passed             Boolean         @default(false)
  estado             EstadoContenido @default(activo)
  ar_card_granted_id Int?
  /// Juego de unir palabras: lo que el servidor ya validó ({ placed: {palabraId: categoría} }) y los errores.
  progreso           Json?
  errores            Int             @default(0)

  exam    Exam                @relation(fields: [exam_id], references: [id])
  alumno  Usuario             @relation(fields: [alumno_id], references: [id])
  details ExamAttemptDetail[]

  @@index([exam_id])
  @@index([alumno_id])
  @@map("exam_attempts")
}

/// Detalle de un intento de examen, neutral a la modalidad (Negocio.md §23).
model ExamAttemptDetail {
  id              Int      @id @default(autoincrement())
  exam_attempt_id Int
  item_ref        String   @db.VarChar(255)
  expected        String?  @db.VarChar(255)
  respuesta       String?  @db.VarChar(255)
  is_correct      Boolean  @default(false)
  time_spent_ms   Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamp(6)

  exam_attempt ExamAttempt @relation(fields: [exam_attempt_id], references: [id], onDelete: Cascade)

  @@index([exam_attempt_id])
  @@map("exam_attempt_details")
}

// ---------------------------------------------------------------------------
// Tarjetas AR — recompensas (Negocio.md §18-21)
// ---------------------------------------------------------------------------

/// Plantilla de una tarjeta AR (física, imprimible). NO representa la copia de
/// un alumno — eso vive en UserArCard.
model ArCard {
  id                Int              @id @default(autoincrement())
  paralelo_id       Int
  card_code         String           @unique @db.VarChar(50)
  title             String?          @db.VarChar(255)
  description       String?          @db.Text
  marker_file       String           @db.VarChar(255)
  image_file        String?          @db.VarChar(255)
  card_data         String?          @db.Text
  patt_data         String?          @db.Text
  image_data        Bytes?
  lamina_data       Bytes?
  model_data        Bytes?
  model_mime        String?          @db.VarChar(50)
  unlock_type       ArCardUnlockType @default(lesson)
  unlock_lesson_id  Int?
  unlock_exam_id    Int?
  estado            EstadoContenido  @default(activo)
  deshabilitado_por Int?
  deshabilitado_at  DateTime?        @db.Timestamp(6)
  motivo            String?          @db.VarChar(255)
  copiado_de        Int?
  created_by        Int?
  updated_by        Int?
  created_at        DateTime         @default(now()) @db.Timestamp(6)
  updated_at        DateTime         @updatedAt @db.Timestamp(6)

  paralelo       Paralelo     @relation(fields: [paralelo_id], references: [id])
  user_cards     UserArCard[]
  exam_links     ExamArCard[]
  lesson_rewards Lesson[]     @relation("LessonRewardCard")
  exam_rewards   Exam[]       @relation("ExamRewardCard")

  @@index([paralelo_id])
  @@index([unlock_lesson_id])
  @@index([unlock_exam_id])
  @@map("ar_cards")
}

/// La copia de una tarjeta que un alumno desbloqueó. Se puede REVOCAR
/// individualmente si fue obtenida por error (Negocio.md §21, §32); la fila se
/// conserva siempre.
model UserArCard {
  id           Int              @id @default(autoincrement())
  alumno_id    Int
  ar_card_id   Int
  unlocked_at  DateTime         @default(now()) @db.Timestamp(6)
  unlocked_by  ArCardUnlockType @default(lesson)
  source_id    Int?
  revocado     Boolean          @default(false)
  revocado_at  DateTime?        @db.Timestamp(6)
  revocado_por Int?
  motivo       String?          @db.VarChar(255)

  alumno  Usuario @relation(fields: [alumno_id], references: [id])
  ar_card ArCard  @relation(fields: [ar_card_id], references: [id])

  @@unique([alumno_id, ar_card_id])
  @@index([alumno_id])
  @@index([ar_card_id])
  @@map("user_ar_cards")
}

// ---------------------------------------------------------------------------
// Logros — automáticos, sin configuración manual (Negocio.md §24, §34)
// ---------------------------------------------------------------------------

model Logro {
  id             Int            @id @default(autoincrement())
  codigo         String         @unique @db.VarChar(60)
  nombre         String         @db.VarChar(120)
  descripcion    String?        @db.VarChar(255)
  icono          String?        @db.VarChar(60)
  categoria      LogroCategoria
  criterio_tipo  String         @db.VarChar(60)
  criterio_valor Int            @default(1)
  activo         Boolean        @default(true)

  alumnos LogroAlumno[]

  @@map("logros")
}

model LogroAlumno {
  id          Int      @id @default(autoincrement())
  alumno_id   Int
  logro_id    Int
  unlocked_at DateTime @default(now()) @db.Timestamp(6)
  progreso    Int?
  contexto    Json?

  alumno Usuario @relation(fields: [alumno_id], references: [id])
  logro  Logro   @relation(fields: [logro_id], references: [id])

  @@unique([alumno_id, logro_id])
  @@index([alumno_id])
  @@map("logro_alumnos")
}

// ---------------------------------------------------------------------------
// Mapa / orden del contenido del paralelo
// ---------------------------------------------------------------------------

model ContentOrder {
  id           Int                         @id @default(autoincrement())
  paralelo_id  Int
  content_type ContentOrderContentTypeEnum
  content_id   Int
  orden        Int
  created_at   DateTime                    @default(now()) @db.Timestamp(6)
  updated_at   DateTime                    @updatedAt @db.Timestamp(6)

  paralelo Paralelo @relation(fields: [paralelo_id], references: [id])

  @@unique([paralelo_id, content_type, content_id])
  @@index([paralelo_id, orden])
  @@map("content_order")
}

// ---------------------------------------------------------------------------
// Diccionario (recurso del colegio, no de un paralelo concreto)
// ---------------------------------------------------------------------------

model Diccionario {
  id          Int             @id @default(autoincrement())
  aymara      String?         @db.VarChar(80)
  espanol     String?         @db.VarChar(120)
  categoria   String          @default("") @db.VarChar(60)
  estado      EstadoContenido @default(activo)
  paralelo_id Int?

  @@index([categoria])
  @@index([paralelo_id])
  @@map("diccionario")
}

model SearchHistory {
  id          Int      @id @default(autoincrement())
  headword    String   @db.VarChar(100)
  gloss       String   @db.VarChar(255)
  search_date DateTime @default(now()) @db.Timestamp(6)

  @@map("search_history")
}

// ---------------------------------------------------------------------------
// Supervisión del administrador (Negocio.md §4, §29)
// ---------------------------------------------------------------------------

model ComentarioRevision {
  id             Int      @id @default(autoincrement())
  contenido_tipo String   @db.VarChar(30)
  contenido_id   Int
  paralelo_id    Int
  autor_id       Int
  texto          String   @db.Text
  resuelto       Boolean  @default(false)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @updatedAt @db.Timestamp(6)

  paralelo Paralelo @relation(fields: [paralelo_id], references: [id])

  @@index([paralelo_id])
  @@index([contenido_tipo, contenido_id])
  @@map("comentarios_revision")
}

// ---------------------------------------------------------------------------
// Analítica descriptiva + predictiva (Negocio.md §26-27)
// ---------------------------------------------------------------------------

/// Agregados recalculables. Las claves usan 0 como centinela (no NULL) para que
/// los upsert por clave compuesta parcial dedupliquen correctamente.
model StatisticsAggregated {
  id                   Int         @id @default(autoincrement())
  stat_type            StatType
  alumno_id            Int         @default(0)
  exercise_id          Int         @default(0)
  lesson_id            Int         @default(0)
  paralelo_id          Int         @default(0)
  gestion_id           Int         @default(0)
  total_attempts       Int         @default(0)
  successful_attempts  Int         @default(0)
  failed_attempts      Int         @default(0)
  average_score        Decimal     @default(0) @db.Decimal(5, 2)
  average_time_ms      Decimal     @default(0) @db.Decimal(12, 2)
  most_common_error    String?     @db.VarChar(100)
  error_pattern        String?     @db.Text
  difficulty_score     Decimal     @default(0) @db.Decimal(5, 2)
  predicted_difficulty Dificultad?
  last_calculated      DateTime    @default(now()) @db.Timestamp(6)
  created_at           DateTime    @default(now()) @db.Timestamp(6)
  updated_at           DateTime    @updatedAt @db.Timestamp(6)

  @@unique([stat_type, alumno_id, exercise_id, lesson_id, paralelo_id, gestion_id])
  @@index([stat_type])
  @@index([paralelo_id])
  @@index([alumno_id])
  @@map("statistics_aggregated")
}

model ErrorPattern {
  id                Int      @id @default(autoincrement())
  alumno_id         Int?
  exercise_id       Int?
  lesson_id         Int?
  error_type        String   @db.VarChar(100)
  error_description String?  @db.Text
  frequency         Int      @default(1)
  pattern_data      String?  @db.Text
  detected_at       DateTime @default(now()) @db.Timestamp(6)
  last_occurrence   DateTime @default(now()) @db.Timestamp(6)

  @@index([alumno_id, exercise_id])
  @@index([error_type])
  @@map("error_patterns")
}

/// Predicción por alumno producida por el modelo ML entrenable (Negocio.md §27).
model PrediccionAlumno {
  id             Int            @id @default(autoincrement())
  alumno_id      Int
  paralelo_id    Int            @default(0)
  tipo           PrediccionTipo
  valor          Decimal        @db.Decimal(6, 3)
  etiqueta       String?        @db.VarChar(60)
  confianza      Decimal        @default(0) @db.Decimal(5, 4)
  features       Json?
  modelo_version String         @default("v1") @db.VarChar(20)
  calculado_at   DateTime       @default(now()) @db.Timestamp(6)

  alumno Usuario @relation(fields: [alumno_id], references: [id])

  @@unique([alumno_id, tipo, modelo_version])
  @@index([alumno_id])
  @@index([paralelo_id])
  @@index([tipo])
  @@map("predicciones_alumno")
}

/// Coeficientes/params de un modelo ML entrenado, para reproducibilidad.
model MlModelo {
  id           Int      @id @default(autoincrement())
  version      String   @unique @db.VarChar(20)
  tipo         String   @db.VarChar(40)
  params       Json
  metricas     Json?
  n_muestras   Int      @default(0)
  entrenado_at DateTime @default(now()) @db.Timestamp(6)
  activo       Boolean  @default(false)

  @@map("ml_modelos")
}

// ---------------------------------------------------------------------------
// Auditoría de acceso
// ---------------------------------------------------------------------------

model AccessLog {
  id         BigInt               @id @default(autoincrement())
  user_id    BigInt?
  email      String?              @db.VarChar(190)
  username   String?              @db.VarChar(190)
  action     AccessLogsActionEnum
  path       String               @db.VarChar(255)
  method     String               @db.VarChar(10)
  ip         String               @db.VarChar(45)
  user_agent String?              @db.Text
  status     Int                  @default(200) @db.SmallInt
  message    String?              @db.VarChar(255)
  created_at DateTime             @default(now()) @db.Timestamp(6)

  @@index([created_at])
  @@index([user_id, action])
  @@index([action])
  @@map("access_logs")
}
