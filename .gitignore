# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos la plantilla: es lo único de lo que partir al clonar en otra máquina.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# referencia del sistema PHP original — no forma parte de la reescritura, no se sube
/sistema viejo/

# herramientas de sesión (launch config del preview local)
/.claude/

# Material subido en tiempo de ejecución (PDF de temas, etc.)
/public/uploads/

# Artefactos que regenera `npm run db:seed` a partir de los marcadores fuente
# de public/ar — no se versionan para no duplicar binarios.
/public/ar/models/
/public/ar/marker_ARCHHAJNA.*
/public/ar/marker_ARANU.*
/public/ar/marker_ARANATA.*
/public/ar/marker_ARPANDA.*
/public/ar/marker_ARWALLPA.*

# Marcadores subidos desde el panel en tiempo de ejecución (`AR` + timestamp).
# Los que ya están versionados no se ven afectados: .gitignore sólo aplica a
# archivos sin trackear.
/public/ar/marker_AR1[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].*
